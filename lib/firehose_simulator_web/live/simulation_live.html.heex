<Layouts.app flash={@flash} current_path={@current_path} current_scope={@current_scope}>
  <.header>
    Simulation
    <:subtitle>Start simulation players and manage active runs.</:subtitle>
  </.header>

  <section id="simulation-config" class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-5">
      <div class="flex items-center gap-2 text-sm font-medium">
        <.icon name="hero-play-circle" class="size-5 text-primary" /> Start simulation player
      </div>

      <.form
        for={@play_form}
        id="simulation-play-form"
        phx-change="validate_play"
        phx-submit="play"
        class="space-y-4"
      >
        <div class="space-y-2">
          <p class="text-sm font-medium">Select simulation plan</p>
          <div id="simulation-plan-list" class="space-y-2">
            <p :if={@plans == []} id="simulation-plans-empty" class="text-sm text-base-content/70">
              No simulation plans available. Generate or import one in Planning.
            </p>

            <button
              :for={plan <- @plans}
              id={"simulation-select-#{plan.id}"}
              type="button"
              phx-click="select_plan"
              phx-value-plan_id={plan.id}
              class={[
                "w-full rounded-box border px-3 py-2 text-left transition-colors",
                @selected_plan_id == plan.id && "border-primary/70 bg-primary/10",
                @selected_plan_id != plan.id && "border-base-300 hover:border-base-content/40"
              ]}
            >
              <p class="text-sm font-semibold">{plan.id}</p>
              <.simulation_plan_summary
                id={"simulation-plan-summary-#{plan.id}"}
                simulation_plan={plan.simulation_plan}
                class="mt-1 text-xs text-base-content/70"
              />
            </button>
          </div>
        </div>

        <div class="grid gap-4 lg:grid-cols-[1fr_auto] lg:items-end">
          <div class="space-y-2">
            <.input
              field={@play_form[:offset_ms]}
              id="simulation-offset-ms"
              type="number"
              label="Start offset (ms)"
            />
            <p id="simulation-offset-help" class="text-xs text-base-content/70">
              Use `0` to start immediately. Positive values shift events later; negative values shift earlier.
            </p>
          </div>

          <.button
            id="play-button"
            type="submit"
            disabled={!@selected_plan_id}
            variant="primary"
          >
            Play selected plan
          </.button>
        </div>
      </.form>

      <p :if={@last_action} id="last-action" class="text-sm text-base-content/80">
        Last action: {@last_action}
      </p>
    </div>
  </section>

  <section
    id="running-players-list"
    class="card bg-base-100 border border-base-300 shadow-sm mt-6"
  >
    <div class="card-body gap-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2 text-sm font-medium">
          <.icon name="hero-queue-list" class="size-5 text-primary" /> Running simulation players
        </div>
        <div class="flex flex-wrap gap-2">
          <.button id="stop-all-button" type="button" phx-click="stop_all">
            Stop All
          </.button>
          <.button id="reset-all-button" type="button" phx-click="reset_all" variant="primary">
            Reset All
          </.button>
        </div>
      </div>

      <p
        :if={@running_players == []}
        id="running-players-empty"
        class="text-sm text-base-content/70"
      >
        No running simulation players.
      </p>

      <div :if={@running_players != []} class="space-y-3">
        <div
          :for={player <- @running_players}
          id={"running-player-#{player.player_id}"}
          class="rounded-box border border-base-300 p-4 transition-colors"
        >
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div class="space-y-1">
              <p class="font-semibold" id={"running-player-id-#{player.player_id}"}>
                {player.player_id}
              </p>
              <p class="text-xs text-base-content/70">
                schedulers: {Map.get(player.metadata, :schedulers, "n/a")} · request interval: {Map.get(
                  player.metadata,
                  :request_interval_ms,
                  "n/a"
                )} ms
              </p>
            </div>

            <div class="flex flex-wrap gap-2">
              <.button
                id={"stop-player-#{player.player_id}"}
                type="button"
                phx-click="stop"
                phx-value-player_id={player.player_id}
              >
                Stop
              </.button>
              <.button
                id={"reset-player-#{player.player_id}"}
                type="button"
                phx-click="reset"
                phx-value-player_id={player.player_id}
                variant="primary"
              >
                Reset
              </.button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="simulation-reports" class="card bg-base-100 border border-base-300 shadow-sm mt-6">
    <div class="card-body gap-4">
      <div class="flex items-center gap-2 text-sm font-medium">
        <.icon name="hero-document-text" class="size-5 text-primary" /> Recent simulation reports
      </div>

      <p
        :if={@simulation_reports == []}
        id="simulation-reports-empty"
        class="text-sm text-base-content/70"
      >
        No reports generated yet. Stop or reset a running player to write one.
      </p>

      <div :if={@simulation_reports != []} id="simulation-reports-list" class="space-y-3">
        <div
          :for={report <- @simulation_reports}
          id={"simulation-report-#{report.player_id}"}
          class="rounded-box border border-base-300 p-4"
        >
          <p id={"simulation-report-player-#{report.player_id}"} class="font-semibold">
            {report.player_id}
          </p>
          <p
            id={"simulation-report-reason-#{report.player_id}"}
            class="text-sm text-base-content/80"
          >
            finalized by: {report.reason}
          </p>
          <p
            id={"simulation-report-finalized-at-#{report.player_id}"}
            class="text-xs text-base-content/70"
          >
            finalized at (ms): {Map.get(report, :finalized_at_ms, "n/a")}
          </p>
          <p
            id={"simulation-report-path-#{report.player_id}"}
            class="mt-2 break-all rounded-box bg-base-200/60 p-2 text-xs"
          >
            report written to: {Map.get(report, :path, "n/a")}
          </p>
        </div>
      </div>
    </div>
  </section>
</Layouts.app>
