<Layouts.app flash={@flash} current_path={@current_path} current_scope={@current_scope}>
  <.header>
    Simulation
    <:subtitle>Load simulation players and control loaded, running, and paused runs.</:subtitle>
  </.header>

  <section id="simulation-config" class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-5">
      <div
        id="simulation-plan-summary"
        class="rounded-box border border-base-300/80 bg-base-200/40 px-4 py-3 text-sm text-base-content/80"
      >
        <%= if @current_simulation_plan.entries == [] do %>
          <p id="simulation-plan-empty">No active simulation plan yet.</p>
        <% else %>
          <p id="simulation-plan-entry-count">
            active plan entries: {length(@current_simulation_plan.entries)}
          </p>
          <p :if={@current_simulation_plan.export_path} id="simulation-plan-export-path">
            last export: {@current_simulation_plan.export_path}
          </p>
        <% end %>
      </div>

      <div class="flex items-center gap-2 text-sm font-medium">
        <.icon name="hero-play-circle" class="size-5 text-primary" /> Load simulation player
      </div>

      <.form
        for={@load_form}
        id="simulation-load-form"
        phx-change="validate_load"
        phx-submit="load"
        class="space-y-4"
      >
        <div class="space-y-2">
          <p class="text-sm font-medium">Select scenario</p>
          <div id="simulation-scenario-list" class="space-y-2">
            <p
              :if={@scenario_ids == []}
              id="simulation-scenarios-empty"
              class="text-sm text-base-content/70"
            >
              No scenarios available. Generate or import one in Planning.
            </p>

            <.link
              :for={scenario_id <- @scenario_ids}
              id={"simulation-select-#{scenario_id}"}
              patch={~p"/simulation?scenario_id=#{scenario_id}"}
              class={[
                "block w-full rounded-box border px-3 py-2 text-left transition-colors",
                @selected_scenario_id == scenario_id &&
                  "border-primary/70 bg-primary/10",
                @selected_scenario_id != scenario_id &&
                  "border-base-300 hover:border-base-content/40"
              ]}
            >
              <p class="text-sm font-semibold">{scenario_id}</p>
              <.scenario_summary
                id={"simulation-scenario-summary-#{scenario_id}"}
                scenario={scenario_for_id(scenario_id)}
                class="mt-1 text-xs text-base-content/70"
              />
            </.link>
          </div>
        </div>

        <div class="grid gap-4 lg:grid-cols-[1fr_auto] lg:items-end">
          <div class="space-y-2">
            <.input
              field={@load_form[:offset_ms]}
              id="simulation-offset-ms"
              type="number"
              label="Start offset (ms)"
            />
            <p id="simulation-offset-help" class="text-xs text-base-content/70">
              Use `0` to load from the beginning. Positive values shift events later; negative values shift earlier.
            </p>
          </div>

          <.button
            id="load-button"
            type="submit"
            disabled={!@selected_scenario_id}
            variant="primary"
          >
            Load selected scenario
          </.button>
        </div>
      </.form>

      <p :if={@last_action} id="last-action" class="text-sm text-base-content/80">
        Last action: {@last_action}
      </p>
    </div>
  </section>

  <section
    id="players-list"
    class="card bg-base-100 border border-base-300 shadow-sm mt-6"
  >
    <div class="card-body gap-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2 text-sm font-medium">
          <.icon name="hero-queue-list" class="size-5 text-primary" /> Simulation players
        </div>
        <div class="flex flex-wrap gap-2">
          <.button id="stop-all-button" type="button" phx-click="stop_all">
            Stop All
          </.button>
        </div>
      </div>

      <p
        :if={@players == []}
        id="players-empty"
        class="text-sm text-base-content/70"
      >
        No simulation players loaded.
      </p>

      <div :if={@players != []} class="space-y-3">
        <div
          :for={player <- @players}
          id={"player-#{player.player_id}"}
          class="rounded-box border border-base-300 p-4 transition-colors"
        >
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div class="space-y-1">
              <div class="flex flex-wrap items-center gap-2">
                <p class="font-semibold" id={"player-id-#{player.player_id}"}>
                  {player.player_id}
                </p>
                <span
                  id={"player-state-#{player.player_id}"}
                  class={[
                    "rounded-full px-2 py-0.5 text-xs font-semibold",
                    player.metadata.lifecycle_state == :running &&
                      "bg-emerald-100 text-emerald-800",
                    player.metadata.lifecycle_state == :paused && "bg-amber-100 text-amber-800",
                    player.metadata.lifecycle_state == :loaded && "bg-sky-100 text-sky-800"
                  ]}
                >
                  {player.metadata.lifecycle_state}
                </span>
              </div>
              <p class="text-xs text-base-content/70">
                scenario: {Map.get(player.metadata, :scenario_id, "n/a")} · schedulers: {Map.get(
                  player.metadata,
                  :schedulers,
                  "n/a"
                )} · request interval: {Map.get(player.metadata, :request_interval_ms, "n/a")} ms · timeline limit: {Map.get(
                  player.metadata,
                  :timeline_limit,
                  "n/a"
                )}
              </p>
              <p class="text-xs text-base-content/60">
                loaded at: {Map.get(player.metadata, :loaded_at, "n/a")} · started at: {Map.get(
                  player.metadata,
                  :started_at,
                  "n/a"
                )} · paused at: {Map.get(player.metadata, :paused_at, "n/a")} · total paused: {Map.get(
                  player.metadata,
                  :total_paused,
                  0
                )}
              </p>
            </div>

            <div class="flex flex-wrap gap-2">
              <.button
                :if={player.metadata.lifecycle_state in [:loaded, :paused]}
                id={"start-player-#{player.player_id}"}
                type="button"
                phx-click="start"
                phx-value-player_id={player.player_id}
              >
                Start
              </.button>
              <.button
                :if={player.metadata.lifecycle_state == :running}
                id={"pause-player-#{player.player_id}"}
                type="button"
                phx-click="pause"
                phx-value-player_id={player.player_id}
              >
                Pause
              </.button>
              <.button
                id={"stop-player-#{player.player_id}"}
                type="button"
                phx-click="stop"
                phx-value-player_id={player.player_id}
                variant="primary"
              >
                Stop
              </.button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layouts.app>
