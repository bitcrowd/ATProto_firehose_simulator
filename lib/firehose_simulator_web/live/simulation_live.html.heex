<Layouts.app flash={@flash} current_path={@current_path} current_scope={@current_scope}>
  <.header>
    Simulation
    <:subtitle>Select a plan and control simulation playback.</:subtitle>
  </.header>

  <section id="simulation-step" class="grid gap-6 lg:grid-cols-2">
    <div class="card bg-base-100 border border-base-300 shadow-sm">
      <div class="card-body gap-5">
        <div class="flex items-center gap-2 text-sm font-medium">
          <.icon name="hero-list-bullet" class="size-5 text-primary" /> Select plan
        </div>

        <div id="simulation-plan-list" class="space-y-2">
          <p :if={@plans == []} id="simulation-plans-empty" class="text-sm text-base-content/70">
            No simulation plans available. Generate or import one in Planning.
          </p>

          <button
            :for={plan_id <- @plans}
            id={"simulation-select-#{plan_id}"}
            type="button"
            phx-click="select_plan"
            phx-value-plan_id={plan_id}
            class={[
              "w-full rounded-box border px-3 py-2 text-left text-sm transition-colors",
              @selected_plan_id == plan_id && "border-primary/70 bg-primary/10",
              @selected_plan_id != plan_id && "border-base-300 hover:border-base-content/40"
            ]}
          >
            {plan_id}
          </button>
        </div>

        <p
          id="plan-status"
          class={[
            "text-sm",
            @selected_plan_id && "text-success"
          ]}
        >
          <%= if @selected_plan_id do %>
            Selected plan: {@selected_plan_id}
          <% else %>
            No simulation plan selected.
          <% end %>
        </p>
      </div>
    </div>

    <div class="card bg-base-100 border border-base-300 shadow-sm">
      <div class="card-body gap-5">
        <div class="flex items-center gap-2 text-sm font-medium">
          <.icon name="hero-play-circle" class="size-5 text-primary" /> Control playback
        </div>

        <div class="flex flex-wrap gap-3">
          <.button
            id="play-button"
            type="button"
            phx-click="play"
            disabled={!@selected_plan_id}
          >
            Play
          </.button>
          <.button id="stop-button" type="button" phx-click="stop" variant="primary">
            Stop
          </.button>
          <.button id="reset-button" type="button" phx-click="reset" variant="primary">
            Reset
          </.button>
        </div>

        <p :if={@last_action} id="last-action" class="text-sm text-base-content/80">
          Last action: {@last_action}
        </p>

        <div id="player-ids" class="rounded-box bg-base-200/60 p-3 text-xs">
          <p class="font-semibold">Stored player IDs</p>
          <pre class="mt-1 overflow-auto">{inspect(@player_ids, pretty: true)}</pre>
        </div>
      </div>
    </div>
  </section>
</Layouts.app>
